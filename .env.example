# Shown in the footer, and the public GitHub repo linked from the summary page.
NEXT_PUBLIC_AUTHOR_NAME=Ankit Yadav
NEXT_PUBLIC_REPO_URL=

# All optional. Anything left blank is reported as "off" in the data layer inspector,
# never faked.

# Mixpanel project token (Project settings -> Access keys). Free plan is enough.
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Set to https://api-eu.mixpanel.com if the project lives in the EU data centre.
NEXT_PUBLIC_MIXPANEL_API_HOST=

# PostHog project API key + host (feature flags + experiments).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Microsoft Clarity project id (heatmaps + session recordings).
NEXT_PUBLIC_CLARITY_ID=

# Neon / any Postgres. Live storefront events are inserted into the events table
# (run db/schema.sql there first). Server-side only.
DATABASE_URL=

# CleverTap (server-side, never exposed to the browser). Region e.g. in1 for India, eu1, us1, sg1.
CLEVERTAP_ACCOUNT_ID=
CLEVERTAP_PASSCODE=
CLEVERTAP_REGION=in1

# MoEngage Data API (server-side). DC = your data centre number (1, 2, 3...).
MOENGAGE_APP_ID=
MOENGAGE_DATA_API_KEY=
MOENGAGE_DC=1

# ---------- AI analyst agents ----------
# Model: Gemini (free tier) or Claude. Optional AGENT_MODEL overrides the default model.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AGENT_MODEL=
# Read-only Neon role created with db/agent-role.sql (falls back to DATABASE_URL).
AGENT_DATABASE_URL=
# Lets scripts/eval.mjs skip the hourly limit. Any long random string.
AGENT_EVAL_KEY=
AGENT_QUESTIONS_PER_HOUR=15

# Slack app (slack/manifest.yml)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ALERT_CHANNEL=
SLACK_APPROVER_IDS=
